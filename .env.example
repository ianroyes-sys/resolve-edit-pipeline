# All optional. Defaults look tools up on PATH.
# ffmpeg / ffprobe binaries
FFMPEG=
FFPROBE=
# whisper.cpp CLI and a ggml model (e.g. ggml-base.en.bin) for card_metadata.py transcripts
WHISPER_CLI=
WHISPER_MODEL=
# DaVinci Resolve scripting modules folder (macOS default shown in pipeline/_config.py)
RESOLVE_SCRIPT_MODULES=
